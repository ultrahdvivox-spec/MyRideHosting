

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ADMIN UID
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == "cT4sWJpjCKf6KL7oT4UnbliYDgp2";
    }

    // ACTIVE DRIVER CHECK
    function isActiveDriver() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/Drivers/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/Drivers/$(request.auth.uid)
        ).data.active == true;
    }

    // CUSTOMER BOOKING
    match /Booking/{bookingId} {

      // Admin, booking owner or authorized driver
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.customerUid == request.auth.uid
        )
        || (
          isActiveDriver()
          && (
            resource.data.status == "Pending"
            || resource.data.driverUid == request.auth.uid
          )
        );

      // Customer can create own Pending booking
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == "Pending"
        && (
          !("driverUid" in request.resource.data)
          || request.resource.data.driverUid == ""
        );

      // Admin can update any booking
      // Driver can accept only an unassigned Pending booking
      allow update: if isAdmin()
        || (
          isActiveDriver()
          && resource.data.status == "Pending"
          && (
            !("driverUid" in resource.data)
            || resource.data.driverUid == ""
          )
          && request.resource.data.status == "Accepted"
          && request.resource.data.driverUid == request.auth.uid
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(["status", "driverUid", "driverEmail"])
        );

      // Only admin can delete bookings
      allow delete: if isAdmin();
    }

    // DRIVER PROFILES
    match /Drivers/{driverId} {

      // Admin can read all; driver can read own profile
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == driverId);

      // Only admin can add, edit or remove drivers
      allow create, update, delete: if isAdmin();
    }

    // Everything else is denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
