
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#111827">
<title>My Ride - Admin Panel</title>
<style>
*{box-sizing:border-box}
body{margin:0;padding:14px;font-family:Arial;background:#f1f5f9;color:#172033}
.container{max-width:1000px;margin:auto}
h2{color:#ca8a04}
.card{background:white;padding:16px;border-radius:12px;margin:12px 0;box-shadow:0 2px 8px #0001}
input,select,button{width:100%;padding:12px;margin:6px 0;border:1px solid #cbd5e1;border-radius:8px;font-size:15px}
button{background:#111827;color:white;border:0;font-weight:bold}
.green{background:#15803d}.red{background:#b91c1c}.orange{background:#c2410c}.gray{background:#475569}
.hidden{display:none!important}
.item{background:#fff;border:1px solid #cbd5e1;border-radius:10px;padding:13px;margin:12px 0;overflow-wrap:anywhere}
.item p{margin:7px 0;line-height:1.5}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.stat{background:#fef3c7;padding:14px;border-radius:9px;text-align:center}
.stat b{font-size:23px;color:#92400e}
.msg{font-size:14px;overflow-wrap:anywhere}
.small{font-size:12px;color:#64748b}
</style>
</head>
<body>
<div class="container">
<h2>🚕 MY RIDE BHILWARA</h2>
<p>Admin Control Panel</p>

<div class="card" id="loginBox">
<h3>🔐 Admin Login</h3>
<input id="email" type="email" placeholder="Admin Email">
<input id="password" type="password" placeholder="Password">
<button id="loginBtn">LOGIN</button>
<p id="loginMsg" class="msg"></p>
</div>

<div id="dashboard" class="hidden">
<div class="card">
<h3>✅ Admin Dashboard</h3>
<p id="adminEmail" class="small"></p>
<button class="gray" id="refreshBtn">🔄 Refresh Data</button>
<button class="red" id="logoutBtn">Logout</button>
</div>

<div class="card">
<h3>📊 Dashboard Summary</h3>
<div class="stats">
<div class="stat"><b id="totalBookings">0</b><p>Total Bookings</p></div>
<div class="stat"><b id="pendingBookings">0</b><p>Pending</p></div>
<div class="stat"><b id="acceptedBookings">0</b><p>Accepted</p></div>
<div class="stat"><b id="completedBookings">0</b><p>Completed</p></div>
<div class="stat"><b id="totalDrivers">0</b><p>Total Drivers</p></div>
<div class="stat"><b id="activeDrivers">0</b><p>Active Drivers</p></div>
</div>
</div>

<div class="card">
<h3>📋 All Bookings</h3>
<select id="bookingFilter">
<option value="ALL">सभी Bookings</option>
<option>Pending</option>
<option>Accepted</option>
<option>Started</option>
<option>Completed</option>
<option>Cancelled</option>
</select>
<p id="bookingMsg" class="msg"></p>
<div id="bookingList">Loading...</div>
</div>

<div class="card">
<h3>🚗 Driver Management</h3>
<select id="driverFilter">
<option value="ALL">सभी Drivers</option>
<option value="PENDING">Verification Pending</option>
<option value="ACTIVE">Active Drivers</option>
<option value="INACTIVE">Inactive Drivers</option>
</select>
<p id="driverMsg" class="msg"></p>
<div id="driverList">Loading...</div>
</div>
</div>
</div>

<script type="module">
import {initializeApp} from "https://www.gstatic.com/firebasejs/11.6.0/firebase-app.js";
import {getAuth,signInWithEmailAndPassword,onAuthStateChanged,signOut} from "https://www.gstatic.com/firebasejs/11.6.0/firebase-auth.js";
import {getFirestore,collection,doc,onSnapshot,updateDoc,serverTimestamp} from "https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js";

const firebaseConfig={
apiKey:"AIzaSyDKWUV2Qx_Jm7R_NVlLNcdUKLAWyZn3P6s",
authDomain:"myridebhilwara-45652.firebaseapp.com",
projectId:"myridebhilwara-45652",
storageBucket:"myridebhilwara-45652.firebasestorage.app",
messagingSenderId:"819961031572",
appId:"1:819961031572:web:b7e1f401c90d7335203d81",
measurementId:"G-WTYS5RWL4V"
};

const ADMIN_UID="cT4sWJpjCKf6KL7oT4UnbliYDgp2";
const app=initializeApp(firebaseConfig);
const auth=getAuth(app);
const db=getFirestore(app);
const $=id=>document.getElementById(id);

let currentAdmin=null,bookings=[],drivers=[];
let stopBookings=null,stopDrivers=null,busy=false;

function msg(id,text){$(id).textContent=text}
function text(parent,tag,value){
const el=document.createElement(tag);
el.textContent=value??"—";
parent.appendChild(el);
return el;
}
function stopListeners(){
if(stopBookings){stopBookings();stopBookings=null}
if(stopDrivers){stopDrivers();stopDrivers=null}
}

$("loginBtn").onclick=async()=>{
const email=$("email").value.trim();
const password=$("password").value;
if(!email||!password){msg("loginMsg","Email और Password भरें");return}
$("loginBtn").disabled=true;
msg("loginMsg","Login हो रहा है...");
try{
await signInWithEmailAndPassword(auth,email,password);
}catch(e){msg("loginMsg","Login Error: "+e.message)}
finally{$("loginBtn").disabled=false}
};

$("logoutBtn").onclick=async()=>{
stopListeners();
await signOut(auth);
};

onAuthStateChanged(auth,user=>{
stopListeners();
currentAdmin=null;
bookings=[];
drivers=[];
$("loginBox").classList.remove("hidden");
$("dashboard").classList.add("hidden");
if(!user)return;
if(user.uid!==ADMIN_UID){
alert("Access Denied: यह Admin Account नहीं है");
signOut(auth).catch(console.error);
return;
}
currentAdmin=user;
$("loginBox").classList.add("hidden");
$("dashboard").classList.remove("hidden");
$("adminEmail").textContent="Login: "+(user.email||user.uid);
startLiveData();
});

function startLiveData(){
stopListeners();
if(!currentAdmin||currentAdmin.uid!==ADMIN_UID)return;

stopBookings=onSnapshot(collection(db,"Booking"),snapshot=>{
bookings=snapshot.docs.map(s=>({id:s.id,...s.data()}));
renderBookings();
stats();
msg("bookingMsg","Booking Data Live Updated");
},e=>msg("bookingMsg","Booking Error: "+e.message));

stopDrivers=onSnapshot(collection(db,"Drivers"),snapshot=>{
drivers=snapshot.docs.map(s=>({id:s.id,...s.data()}));
renderDrivers();
stats();
msg("driverMsg","Driver Data Live Updated");
},e=>msg("driverMsg","Driver Error: "+e.message));
}

function stats(){
$("totalBookings").textContent=bookings.length;
$("pendingBookings").textContent=bookings.filter(b=>b.status==="Pending").length;
$("acceptedBookings").textContent=bookings.filter(b=>b.status==="Accepted").length;
$("completedBookings").textContent=bookings.filter(b=>b.status==="Completed").length;
$("totalDrivers").textContent=drivers.length;
$("activeDrivers").textContent=drivers.filter(d=>d.active===true&&d.verified===true).length;
}

$("bookingFilter").onchange=renderBookings;
$("driverFilter").onchange=renderDrivers;

function renderBookings(){
const list=$("bookingList");
list.replaceChildren();
let rows=[...bookings];
const filter=$("bookingFilter").value;
if(filter!=="ALL")rows=rows.filter(b=>b.status===filter);
rows.sort((a,b)=>(b.createdAt?.seconds||0)-(a.createdAt?.seconds||0));

if(!rows.length){text(list,"p","कोई Booking नहीं मिली");return}

rows.forEach(b=>{
const item=document.createElement("div");
item.className="item";
text(item,"b",(b.pickup||"—")+" → "+(b.destination||"—"));
text(item,"p","Booking ID: "+b.id);
text(item,"p","Customer: "+(b.customerName||"—"));
text(item,"p","Customer Email: "+(b.customerEmail||"—"));
text(item,"p","Mobile: "+(b.customerPhone||"—"));
text(item,"p","Alternate Mobile: "+(b.alternatePhone||"Not Provided"));
text(item,"p","Vehicle: "+(b.vehicleType||"—"));
text(item,"p","Fare: ₹"+(b.fare??b.estimatedFare??0));
text(item,"p","Status: "+(b.status||"—"));
text(item,"p","Driver: "+(b.driverName||"Not Assigned"));
text(item,"p","Driver Mobile: "+(b.driverPhone||"—"));
text(item,"p","Vehicle Number: "+(b.vehicleNumber||"—"));

const select=document.createElement("select");
["Pending","Accepted","Started","Completed","Cancelled"].forEach(s=>{
const o=document.createElement("option");
o.value=s;o.textContent=s;o.selected=s===b.status;
select.append(o);
});
item.append(select);

const button=document.createElement("button");
button.textContent="Update Booking Status";
button.onclick=()=>changeBookingStatus(b.id,select.value,button);
item.append(button);
list.append(item);
});
}

async function changeBookingStatus(id,status,button){
if(!currentAdmin||currentAdmin.uid!==ADMIN_UID||busy)return;
if(!confirm("Booking Status "+status+" करना चाहते हैं?"))return;
busy=true;button.disabled=true;
try{
await updateDoc(doc(db,"Booking",id),{
status:status,
adminUpdatedAt:serverTimestamp()
});
alert("Booking Status Updated");
}catch(e){alert("Booking Error: "+e.message)}
finally{busy=false;button.disabled=false}
}

function renderDrivers(){
const list=$("driverList");
list.replaceChildren();
let rows=[...drivers];
const filter=$("driverFilter").value;
if(filter==="PENDING")rows=rows.filter(d=>d.verified!==true);
if(filter==="ACTIVE")rows=rows.filter(d=>d.active===true&&d.verified===true);
if(filter==="INACTIVE")rows=rows.filter(d=>d.active!==true||d.verified!==true);
if(!rows.length){text(list,"p","कोई Driver नहीं मिला");return}

rows.forEach(d=>{
const item=document.createElement("div");
item.className="item";
text(item,"b","🚗 "+(d.name||"Driver"));
text(item,"p","UID: "+d.id);
text(item,"p","Mobile: "+(d.phone||"—"));
text(item,"p","Vehicle Number: "+(d.vehicleNumber||"—"));
text(item,"p","Vehicle Model: "+(d.vehicleModel||"—"));
text(item,"p","License: "+(d.licenseNumber||"—"));
text(item,"p","Verified: "+(d.verified===true?"Yes":"No"));
text(item,"p","Active: "+(d.active===true?"Yes":"No"));

const verify=document.createElement("button");
verify.className="green";
verify.textContent="Verify + Activate Driver";
verify.onclick=()=>updateDriver(d.id,true,true,verify);

const inactive=document.createElement("button");
inactive.className="orange";
inactive.textContent="Verified रखें, Inactive करें";
inactive.onclick=()=>updateDriver(d.id,true,false,inactive);

const reject=document.createElement("button");
reject.className="red";
reject.textContent="Unverify + Inactive";
reject.onclick=()=>updateDriver(d.id,false,false,reject);

item.append(verify,inactive,reject);
list.append(item);
});
}

async function updateDriver(uid,verified,active,button){
if(!currentAdmin||currentAdmin.uid!==ADMIN_UID||busy)return;
if(!confirm("Driver का Status बदलना चाहते हैं?"))return;
busy=true;button.disabled=true;
try{
await updateDoc(doc(db,"Drivers",uid),{
verified:verified,
active:active,
updatedAt:serverTimestamp()
});
alert("Driver Status Updated");
}catch(e){alert("Driver Error: "+e.message)}
finally{busy=false;button.disabled=false}
}

$("refreshBtn").onclick=()=>{
if(currentAdmin&&currentAdmin.uid===ADMIN_UID){
startLiveData();
msg("bookingMsg","Refreshing...");
msg("driverMsg","Refreshing...");
}
};
</script>
</body>
</html>
