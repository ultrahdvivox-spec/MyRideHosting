
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>My Ride Bhilwara Admin</title>
<style>
*{box-sizing:border-box}
body{font-family:Arial;background:#eef2ff;color:#172033;margin:0;padding:14px}
.container{max-width:900px;margin:auto}
.card{background:white;padding:18px;border-radius:13px;margin:12px 0}
input,button{width:100%;padding:12px;margin:6px 0;border:1px solid #ccc;border-radius:8px;font-size:15px}
button{background:#1d4ed8;color:white;border:0;font-weight:bold}
.reject{background:#b91c1c}
.refresh{background:#475569}
.item{border:1px solid #ddd;padding:13px;border-radius:10px;margin:12px 0;overflow-wrap:anywhere}
.hidden{display:none}
</style>
</head>
<body>
<div class="container">
<h2>🚗 My Ride Bhilwara — Admin</h2>

<div class="card" id="loginBox">
<h3>Admin Login</h3>
<input id="email" type="email" placeholder="Admin Email">
<input id="password" type="password" placeholder="Password">
<button id="loginBtn">Login</button>
<p id="message"></p>
</div>

<div id="panel" class="hidden">
<div class="card">
<b>Admin Panel</b>
<button id="logoutBtn" class="refresh">Logout</button>
</div>

<div class="card">
<h3>सभी बुकिंग</h3>
<h3 id="total">कुल बुकिंग: 0</h3>
<button id="refreshBtn" class="refresh">बुकिंग Refresh करें</button>
<div id="bookings">लोड हो रहा है...</div>
</div>

<div class="card">
<h3>Driver Verification</h3>
<div id="drivers">लोड हो रहा है...</div>
</div>
</div>
</div>

<script type="module">
import {initializeApp} from "https://www.gstatic.com/firebasejs/11.6.0/firebase-app.js";
import {
getAuth,signInWithEmailAndPassword,onAuthStateChanged,signOut
} from "https://www.gstatic.com/firebasejs/11.6.0/firebase-auth.js";
import {
getFirestore,collection,doc,onSnapshot,updateDoc,
serverTimestamp
} from "https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js";

const firebaseConfig={
apiKey:"AIzaSyDKWUV2Qx_Jm7R_NVlLNcdUKLAWyZn3P6s",
authDomain:"myridebhilwara-45652.firebaseapp.com",
projectId:"myridebhilwara-45652",
storageBucket:"myridebhilwara-45652.firebasestorage.app",
messagingSenderId:"819961031572",
appId:"1:819961031572:web:b7e1f401c90d7335203d81",
measurementId:"G-WTYS5RWL4V"
};

const ADMIN_UID="cT4sWJpjCKf6KL7oT4UnbliYDgp2";

const app=initializeApp(firebaseConfig);
const auth=getAuth(app);
const db=getFirestore(app);
const $=id=>document.getElementById(id);

let stopBookings=null;
let stopDrivers=null;

$("loginBtn").onclick=async()=>{
try{
await signInWithEmailAndPassword(
auth,$("email").value.trim(),$("password").value
);
}catch(e){$("message").textContent=e.message;}
};

$("logoutBtn").onclick=()=>signOut(auth);

onAuthStateChanged(auth,user=>{
if(stopBookings)stopBookings();
if(stopDrivers)stopDrivers();

const allowed=user&&user.uid===ADMIN_UID;

$("loginBox").classList.toggle("hidden",!!allowed);
$("panel").classList.toggle("hidden",!allowed);

if(user&&!allowed){
$("message").textContent="यह Account Admin नहीं है।";
signOut(auth);
return;
}

if(allowed)startListeners();
});

function startListeners(){
stopBookings=onSnapshot(collection(db,"Booking"),snapshot=>{
$("total").textContent="कुल बुकिंग: "+snapshot.size;
const host=$("bookings");
host.innerHTML="";

const rows=snapshot.docs.sort((a,b)=>
(b.data().createdAt?.seconds||0)-
(a.data().createdAt?.seconds||0)
);

rows.forEach(s=>{
const d=s.data();
const el=document.createElement("div");
el.className="item";

function line(label,value){
const p=document.createElement("p");
p.textContent=label+": "+(value??"—");
el.append(p);
}

line("Booking ID",s.id);
line("शुरुआत",d.pickup);
line("मंजिल",d.destination);
line("वाहन",d.vehicleType);
line("Customer",d.customerName);
line("Customer Mobile",d.customerPhone);
line("Driver",d.driverName);
line("Driver Mobile",d.driverPhone);
line("स्टेटस",d.status);
line("Fare","₹"+(d.fare??0));

if(["Pending","Accepted","Started"].includes(d.status)){
if(d.status==="Pending"){
const accept=document.createElement("button");
accept.textContent="Accept Booking";
accept.onclick=()=>changeStatus(s.id,"Accepted");
el.append(accept);
}

const reject=document.createElement("button");
reject.textContent="Reject Booking";
reject.className="reject";
reject.onclick=()=>changeStatus(s.id,"Rejected");
el.append(reject);
}

host.append(el);
});
},error=>{
$("bookings").textContent="Error: "+error.message;
});

stopDrivers=onSnapshot(collection(db,"Drivers"),snapshot=>{
const host=$("drivers");
host.innerHTML="";

snapshot.forEach(s=>{
const d=s.data();
const el=document.createElement("div");
el.className="item";

const info=document.createElement("p");
info.textContent=(d.name||"नाम नहीं")+
" | "+(d.phone||"मोबाइल नहीं")+
" | "+(d.vehicleNumber||"गाड़ी नंबर नहीं")+
" | Verified: "+!!d.verified+
" | Active: "+!!d.active;
el.append(info);

const btn=document.createElement("button");
btn.textContent=d.verified&&d.active?
"Driver Disable करें":"Verify और Activate करें";

btn.onclick=async()=>{
try{
await updateDoc(doc(db,"Drivers",s.id),{
verified:!(d.verified&&d.active),
active:!(d.verified&&d.active),
updatedAt:serverTimestamp()
});
}catch(e){alert("Driver Update Error: "+e.message);}
};
el.append(btn);
host.append(el);
});
},error=>{
$("drivers").textContent="Driver Error: "+error.message;
});
}

async function changeStatus(id,status){
try{
await updateDoc(doc(db,"Booking",id),{
status:status,
adminUpdatedAt:serverTimestamp()
});
}catch(e){
alert("Update Error: "+e.message);
}
}

$("refreshBtn").onclick=()=>location.reload();
</script>
</body>
</html>
