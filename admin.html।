
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>My Ride Admin</title>
<style>
*{box-sizing:border-box}
body{font-family:Arial,sans-serif;background:#eef2ff;margin:0;padding:14px;color:#172033}
.container{max-width:900px;margin:auto}
.card{background:white;padding:16px;border-radius:12px;margin:12px 0;box-shadow:0 2px 8px #0001}
h2{margin-top:0}
input{width:100%;padding:12px;margin:7px 0;border:1px solid #ccd2df;border-radius:8px}
button{padding:10px 14px;border:0;border-radius:8px;background:#2457d6;color:white;margin:5px 4px 5px 0;cursor:pointer}
button.red{background:#c62828}
button.green{background:#16834a}
button.gray{background:#555}
.small{color:#64748b;font-size:13px}
.status{font-weight:bold}
.hidden{display:none}
.item{border:1px solid #e1e5ee;border-radius:10px;padding:12px;margin:10px 0}
</style>
</head>
<body>
<div class="container">
<h2>🚗 My Ride Bhilwara — Admin</h2>

<div class="card" id="loginBox">
<h3>Admin Login</h3>
<input id="email" type="email" placeholder="Admin Email">
<input id="password" type="password" placeholder="Password">
<button id="loginBtn">Login करें</button>
<p id="loginMsg"></p>
</div>

<div id="adminPanel" class="hidden">
<div class="card">
<b id="adminEmail"></b>
<button class="gray" id="logoutBtn">Logout</button>
</div>

<div class="card">
<h2>🚕 सभी Bookings</h2>
<button id="refreshBookings">Bookings Refresh करें</button>
<p id="bookingCount">लोड हो रहा है...</p>
<div id="bookings"></div>
</div>

<div class="card">
<h2>🚘 Driver Profiles</h2>
<button id="refreshDrivers">Drivers Refresh करें</button>
<p id="driverCount">लोड हो रहा है...</p>
<div id="drivers"></div>
</div>
</div>
</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.0/firebase-app.js";
import {
 getAuth, signInWithEmailAndPassword, onAuthStateChanged, signOut
} from "https://www.gstatic.com/firebasejs/11.6.0/firebase-auth.js";
import {
 getFirestore, collection, onSnapshot, doc, updateDoc, serverTimestamp
} from "https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js";

const firebaseConfig = {
 apiKey: "YOUR_API_KEY",
 authDomain: "myridebhilwara-45652.firebaseapp.com",
 projectId: "myridebhilwara-45652",
 storageBucket: "myridebhilwara-45652.firebasestorage.app",
 messagingSenderId: "819961031572",
 appId: "1:819961031572:web:b7e1f401c90d7335203d81",
 measurementId: "G-WTYS5RWL4V"
};

const ADMIN_UID = "cT4sWJpjCKf6KL7oT4UnbliYDgp2";

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);

const $ = id => document.getElementById(id);
let stopBookings = null;
let stopDrivers = null;

function showMessage(id, message) {
 $(id).textContent = message;
}

function safe(value) {
 return String(value ?? "").replace(/[&<>"']/g, ch => ({
  "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
 })[ch]);
}

$("loginBtn").onclick = async () => {
 const email = $("email").value.trim();
 const password = $("password").value;
 if (!email || !password) {
  showMessage("loginMsg","Email और Password भरें।");
  return;
 }
 try {
  await signInWithEmailAndPassword(auth,email,password);
 } catch(error) {
  showMessage("loginMsg","Login Error: " + error.message);
 }
};

$("logoutBtn").onclick = () => signOut(auth);

onAuthStateChanged(auth, user => {
 if (stopBookings) stopBookings();
 if (stopDrivers) stopDrivers();
 stopBookings = null;
 stopDrivers = null;

 if (!user) {
  $("loginBox").classList.remove("hidden");
  $("adminPanel").classList.add("hidden");
  return;
 }

 if (user.uid !== ADMIN_UID) {
  $("loginBox").classList.remove("hidden");
  $("adminPanel").classList.add("hidden");
  showMessage("loginMsg","यह Account Admin नहीं है।");
  signOut(auth);
  return;
 }

 $("loginBox").classList.add("hidden");
 $("adminPanel").classList.remove("hidden");
 $("adminEmail").textContent = user.email || "Admin";

 loadBookings();
 loadDrivers();
});

function loadBookings() {
 if (stopBookings) stopBookings();

 stopBookings = onSnapshot(collection(db,"Booking"), snapshot => {
  $("bookingCount").textContent = "कुल बुकिंग: " + snapshot.size;

  if (snapshot.empty) {
   $("bookings").textContent = "अभी कोई Booking नहीं है।";
   return;
  }

  $("bookings").innerHTML = snapshot.docs.map(item => {
   const b = item.data();
   const id = item.id;
   return `
    <div class="item">
     <b>Booking ID:</b> ${safe(id)}<br>
     <b>शुरुआत:</b> ${safe(b.pickup || "-")}<br>
     <b>मंजिल:</b> ${safe(b.destination || "-")}<br>
     <b>वाहन:</b> ${safe(b.vehicleType || "-")}<br>
     <b>Customer:</b> ${safe(b.customerName || "-")}<br>
     <b>Customer Phone:</b> ${safe(b.customerPhone || "-")}<br>
     <b>Driver:</b> ${safe(b.driverName || "-")}<br>
     <b>Driver Phone:</b> ${safe(b.driverPhone || "-")}<br>
     <b>स्टेटस:</b> <span class="status">${safe(b.status || "-")}</span><br>
     ${b.status === "Pending" ? `<button class="red" data-reject="${safe(id)}">Reject Booking</button>` : ""}
    </div>`;
  }).join("");

  document.querySelectorAll("[data-reject]").forEach(button => {
   button.onclick = () => rejectBooking(button.dataset.reject);
  });

 }, error => {
  showMessage("bookingCount","Booking Error: " + error.message);
 });
}

async function rejectBooking(id) {
 if (!confirm("क्या आप यह Booking Reject करना चाहते हैं?")) return;
 try {
  await updateDoc(doc(db,"Booking",id), {
   status:"Rejected",
   adminUpdatedAt:serverTimestamp()
  });
  alert("Booking Reject हो गई।");
 } catch(error) {
  alert("Reject Error: " + error.message);
 }
}

function loadDrivers() {
 if (stopDrivers) stopDrivers();

 stopDrivers = onSnapshot(collection(db,"Drivers"), snapshot => {
  $("driverCount").textContent = "कुल Driver Profiles: " + snapshot.size;

  if (snapshot.empty) {
   $("drivers").textContent =
    "अभी कोई Driver Profile नहीं मिली। Driver को पहले अपना Profile Save करना होगा।";
   return;
  }

  $("drivers").innerHTML = snapshot.docs.map(item => {
   const d = item.data();
   const id = item.id;
   const verified = d.verified === true;
   const active = d.active === true;
   const enabled = verified && active;

   return `
    <div class="item">
     <b>Driver Name:</b> ${safe(d.name || "-")}<br>
     <b>Mobile:</b> ${safe(d.phone || "-")}<br>
     <b>Vehicle:</b> ${safe(d.vehicleNumber || "-")}<br>
     <b>Model:</b> ${safe(d.vehicleModel || "-")}<br>
     <b>Verified:</b> ${verified ? "Yes" : "No"}<br>
     <b>Active:</b> ${active ? "Yes" : "No"}<br>
     <b>Driver UID:</b> <span class="small">${safe(id)}</span><br>
     <button class="${enabled ? "red" : "green"}"
       data-driver="${safe(id)}"
       data-enabled="${enabled ? "yes" : "no"}">
       ${enabled ? "Deactivate Driver" : "Verify / Activate"}
     </button>
    </div>`;
  }).join("");

  document.querySelectorAll("[data-driver]").forEach(button => {
   button.onclick = () => toggleDriver(
    button.dataset.driver,
    button.dataset.enabled === "yes"
   );
  });

 }, error => {
  showMessage("driverCount","Drivers Error: " + error.message);
 });
}

async function toggleDriver(id, currentlyEnabled) {
 const action = currentlyEnabled ? "Deactivate" : "Verify और Activate";
 if (!confirm("क्या आप Driver को " + action + " करना चाहते हैं?")) return;

 try {
  await updateDoc(doc(db,"Drivers",id), {
   verified: !currentlyEnabled,
   active: !currentlyEnabled,
   updatedAt: serverTimestamp()
  });
  alert("Driver Profile अपडेट हो गई।");
 } catch(error) {
  alert("Driver Update Error: " + error.message);
 }
}

$("refreshBookings").onclick = loadBookings;
$("refreshDrivers").onclick = loadDrivers;
</script>
</body>
</html>
